# Copy to .env and fill in values (KA Inventory spreadsheet)

GOOGLE_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_CREDENTIALS_JSON=/path/to/kommu-newsletter.json
NEWSLETTER_SHEET_TAB=Newsletter
ORDERS_SHEET_TAB=Orders

# Subscribe API (Tailscale Funnel exposes SUBSCRIBE_API_PORT)
SUBSCRIBE_API_HOST=127.0.0.1
SUBSCRIBE_API_PORT=8788
NEWSLETTER_CORS_ORIGINS=https://kommu.ai,https://www.kommu.ai,https://alexanderyeohsx.github.io

SMTP_HOST=smtp.migadu.com
SMTP_PORT=465
SMTP_TLS=true
SMTP_USER=newsletter@kommu.ai
SMTP_PASSWORD=your_smtp_password
MAIL_FROM="Kommu <newsletter@kommu.ai>"

MAX_SENDS_PER_RUN=50
