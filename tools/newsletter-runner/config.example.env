# Copy to .env and fill in values

GOOGLE_SPREADSHEET_ID=your_spreadsheet_id
# Inline JSON or path to service account file (same as Lambda GOOGLE_CREDENTIALS_JSON)
GOOGLE_CREDENTIALS_JSON=/path/to/service-account.json
NEWSLETTER_SHEET_TAB=Newsletter

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=newsletter@kommu.ai
SMTP_PASSWORD=your_app_password
MAIL_FROM="Kommu <newsletter@kommu.ai>"

# Safety cap per cron run
MAX_SENDS_PER_RUN=50
